  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Suixinlei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suixinlei/opencode-v1-to-v2.git"
  },
  "homepage": "https://github.com/Suixinlei/opencode-v1-to-v2#readme",
  "bugs": {
    "url": "https://github.com/Suixinlei/opencode-v1-to-v2/issues"
  },
  "keywords": [
    "opencode",
    "migration",
    "sqlite",
    "session-history",
    "data-migration"
  ],
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
